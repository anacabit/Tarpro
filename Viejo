  });
}

function buildPills(id,arr,key){
  const g=document.getElementById(id);
  arr.forEach((item,i)=>{
    const d=document.createElement("div");
    d.className="pill"+(S[key]===i?" on":"");
    d.textContent=item.l;
    d.onclick=()=>{S[key]=i;document.querySelectorAll("#"+id+" .pill").forEach((el,j)=>el.classList.toggle("on",j===i));renderAll();};
    g.appendChild(d);
