function buildProfGrid(){
  const g=document.getElementById("profGrid");
  PROFS.forEach((p,i)=>{
    const d=document.createElement("div");
    d.className="prof-item"+(i===0?" on":"");
    d.innerHTML=`<div class="pi-icon">${p.e}</div><div class="pi-name">${p.n}</div>`;
    d.onclick=()=>{
      S.profIdx=i;
      document.querySelectorAll(".prof-item").forEach((el,j)=>el.classList.toggle("on",j===i));
      if(S.iconMode==="emoji"){S.iconEmoji=p.e;syncIconGrid();}
      renderAll();
    };
    g.appendChild(d);
  });
}

function buildIconGrid(){
  const g=document.getElementById("iconGrid");
  EMOJIS.forEach((em,i)=>{
    const d=document.createElement("div");
    d.className="icon-item"+(em===S.iconEmoji?" on":"");
    d.textContent=em;
    d.onclick=()=>{S.iconEmoji=em;document.querySelectorAll(".icon-item").forEach((el,j)=>el.classList.toggle("on",EMOJIS[j]===em));renderAll();};
    g.appendChild(d);
  });
}

function syncIconGrid(){
  document.querySelectorAll(".icon-item").forEach((el,j)=>el.classList.toggle("on",EMOJIS[j]===S.iconEmoji));
}

function buildQRStyleGrid(){
  const g=document.getElementById("qrStyleGrid");
  QR_STYLES_LIST.forEach((qs,i)=>{
    const d=document.createElement("div");
    d.className="qr-style-item"+(i===0?" on":"");
    const cv=document.createElement("canvas");cv.width=34;cv.height=34;
    drawQRStyled(cv,qs.v,"#0077b6","#ffffff","#023e8a");
    const lbl=document.createElement("div");lbl.className="qr-style-lbl";lbl.textContent=qs.l;
    d.appendChild(cv);d.appendChild(lbl);
    d.onclick=()=>{
      S.qrStyle=qs.v;
      document.querySelectorAll(".qr-style-item").forEach((el,j)=>el.classList.toggle("on",j===i));
      renderAll();
    };
    g.appendChild(d);
  });
}

function buildPaletteCats(){
  const g=document.getElementById("paletteCats");g.innerHTML="";
  Object.keys(PALETTES).forEach(cat=>{
    const d=document.createElement("div");
    d.className="pcat"+(cat===S.paletteCat?" on":"");
    d.textContent=cat;
    d.onclick=()=>{S.paletteCat=cat;buildPaletteCats();buildPaletteSwatches();};
    g.appendChild(d);
  });
}

function buildPaletteSwatches(){
  const g=document.getElementById("paletteSwatches");g.innerHTML="";
  (PALETTES[S.paletteCat]||[]).forEach(item=>{
    const d=document.createElement("div");
    d.className="pal-sw"+(item.c===S.c1?" on":"");
    d.style.background=item.c;
    d.onclick=()=>{
      S.c1=item.c;document.getElementById("c1pick").value=item.c;
      document.querySelectorAll(".pal-sw").forEach(s=>s.classList.remove("on"));d.classList.add("on");
      renderAll();
