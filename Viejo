<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mi Tarjeta Pro v4</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f0f2f5;min-height:100vh}

/* ── LOGIN ── */
#loginScreen{position:fixed;top:0;left:0;width:100%;height:100%;background:linear-gradient(135deg,#1a1a2e 0%,#16213e 60%,#0f3460 100%);z-index:9999;display:flex;align-items:center;justify-content:center}
.login-box{background:rgba(255,255,255,0.07);backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.15);border-radius:20px;padding:36px 28px;width:310px;max-width:92vw;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.5)}
.login-logo{font-size:34px;margin-bottom:6px}
.login-title{font-size:19px;font-weight:800;color:#fff;margin-bottom:3px}
.login-sub{font-size:11px;color:rgba(255,255,255,0.45);margin-bottom:28px;letter-spacing:.5px}
.login-label{font-size:10px;color:rgba(255,255,255,0.55);font-weight:700;letter-spacing:.8px;text-transform:uppercase;display:block;margin-bottom:5px;text-align:left}
.login-input{width:100%;padding:10px 13px;border-radius:9px;border:1.5px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.08);color:#fff;font-size:13px;outline:none;margin-bottom:10px;transition:border-color .2s}
.login-input:focus{border-color:#1a73e8}
.login-input::placeholder{color:rgba(255,255,255,0.3)}
.pass-wrap{position:relative}
.pass-wrap .login-input{padding-right:38px}
.eye-btn{position:absolute;right:11px;top:50%;transform:translateY(-60%);cursor:pointer;font-size:15px;opacity:.45;background:none;border:none;color:#fff}
.login-err{font-size:11px;color:#ff6b6b;min-height:16px;margin-bottom:8px;font-weight:600}
.login-btn{width:100%;padding:11px;background:linear-gradient(135deg,#1a73e8,#0d47a1);color:#fff;border:none;border-radius:9px;font-size:14px;font-weight:700;cursor:pointer;letter-spacing:.3px;transition:opacity .15s;margin-bottom:14px}
.login-btn:hover{opacity:.9}
.login-attempts{font-size:10px;color:rgba(255,255,255,0.3)}
.login-footer{margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,0.08);font-size:10px;color:rgba(255,255,255,0.25)}

/* ── HEADER ── */
.hdr{background:#1a1a2e;color:#fff;padding:10px 14px;display:flex;align-items:center;gap:8px;position:sticky;top:0;z-index:200;box-shadow:0 2px 8px rgba(0,0,0,.3)}
.hdr-title{font-size:14px;font-weight:800}
.hdr-title span{background:#1a73e8;border-radius:5px;padding:2px 7px;font-size:9px;font-weight:700;margin-left:5px}
.mode-tabs{display:flex;gap:3px;margin-left:auto}
.mode-tab{padding:5px 10px;border-radius:6px;font-size:10px;font-weight:700;cursor:pointer;border:1.5px solid rgba(255,255,255,.2);color:rgba(255,255,255,.5);background:transparent;transition:all .15s}
.mode-tab.on{background:#1a73e8;color:#fff;border-color:#1a73e8}

/* ── SHELL ── */
.shell{display:grid;grid-template-columns:340px 1fr;min-height:calc(100vh - 44px)}
.panel{background:#fff;border-right:1px solid #e0e0e0;overflow-y:auto;padding:12px}
.stage{display:flex;flex-direction:column;align-items:center;padding:16px 10px;gap:12px;overflow-y:auto}

/* ── PEDIDOS SHEET ── */
.sheet-bar{background:#0f9d58;color:#fff;border-radius:10px;padding:10px 12px;margin-bottom:10px}
.sheet-bar-title{font-size:11px;font-weight:700;margin-bottom:6px;display:flex;align-items:center;gap:5px}
.sheet-input-row{display:flex;gap-4px;gap:4px;margin-bottom:6px}
.sheet-input-row input{flex:1;font-size:11px;padding:5px 8px;border-radius:6px;border:none;background:rgba(255,255,255,0.2);color:#fff;outline:none}
.sheet-input-row input::placeholder{color:rgba(255,255,255,.6)}
.sheet-input-row button{padding:5px 10px;border-radius:6px;border:none;background:#fff;color:#0f9d58;font-size:10px;font-weight:700;cursor:pointer;white-space:nowrap}
.pedidos-list{display:flex;flex-direction:column;gap:4px;max-height:160px;overflow-y:auto}
.pedido-item{background:rgba(255,255,255,0.15);border-radius:7px;padding:7px 10px;cursor:pointer;transition:background .15s;border:1.5px solid transparent}
.pedido-item:hover{background:rgba(255,255,255,0.25)}
.pedido-item.sel{border-color:#fff;background:rgba(255,255,255,0.28)}
.pedido-nombre{font-size:12px;font-weight:700;color:#fff}
.pedido-prof{font-size:10px;color:rgba(255,255,255,.75)}
.pedido-fecha{font-size:9px;color:rgba(255,255,255,.55);margin-top:1px}
.sheet-status{font-size:10px;color:rgba(255,255,255,.7);text-align:center;padding:8px}

/* ── PANEL FIELDS ── */
.sec{margin-bottom:11px}
.sec-title{font-size:9.5px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px;padding-bottom:3px;border-bottom:1px solid #f0f0f0}
.field{margin-bottom:6px}
.field label{font-size:10.5px;color:#555;display:block;margin-bottom:2px;font-weight:500}
.field input,.field select,.field textarea{width:100%;padding:5px 8px;border-radius:6px;border:1.5px solid #e8e8e8;font-size:11.5px;color:#222;background:#fafafa;transition:border-color .15s}
.field input:focus,.field select:focus,.field textarea:focus{border-color:#1a73e8;outline:none;background:#fff}
.field textarea{resize:none;height:46px;line-height:1.4}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:3px}
.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px}
.g4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:3px}
.pill{font-size:9.5px;padding:3px 7px;border-radius:20px;border:1.5px solid #e0e0e0;cursor:pointer;color:#666;background:#f8f8f8;transition:all .15s;text-align:center}
.pill.on{background:#1a73e8;color:#fff;border-color:#1a73e8}

/* ── PROF ── */
.prof-tabs{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-bottom:6px}
.prof-tab{font-size:10px;padding:5px;border-radius:7px;border:1.5px solid #e0e0e0;cursor:pointer;color:#666;background:#f8f8f8;text-align:center;transition:all .15s}
.prof-tab.on{background:#1a73e8;color:#fff;border-color:#1a73e8}
.prof-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;max-height:130px;overflow-y:auto}
.prof-item{border-radius:6px;padding:5px 2px;text-align:center;cursor:pointer;border:1.5px solid #e8e8e8;background:#fafafa;transition:all .15s}
.prof-item.on{border-color:#1a73e8;background:#e8f0fe}
.pi-icon{font-size:15px}
.pi-name{font-size:7px;color:#555;line-height:1.2}

/* ── ICONOS ── */
.icon-tabs{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px;margin-bottom:6px}
.icon-tab{font-size:10px;padding:5px 3px;border-radius:7px;border:1.5px solid #e0e0e0;cursor:pointer;color:#666;background:#f8f8f8;text-align:center;transition:all .15s;line-height:1.3}
.icon-tab.on{background:#0f9d58;color:#fff;border-color:#0f9d58}
.icon-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:3px;max-height:100px;overflow-y:auto}
.icon-item{border-radius:6px;padding:4px 2px;text-align:center;cursor:pointer;border:1.5px solid #e8e8e8;background:#fafafa;font-size:16px;transition:all .15s}
.icon-item.on{border-color:#0f9d58;background:#e8f5e9}

/* ── FOTOS ── */
.foto-block{background:#fff8f0;border-radius:9px;padding:9px;border:1.5px solid #ffe0b2;margin-bottom:6px}
.foto-block-title{font-size:10px;font-weight:700;color:#f57c00;margin-bottom:6px;display:flex;align-items:center;gap:4px}
.foto-opt-row{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:3px;margin-bottom:6px}
.foto-opt{font-size:9px;padding:4px 2px;border-radius:6px;border:1.5px solid #e0e0e0;cursor:pointer;color:#666;background:#fff;text-align:center;transition:all .15s;line-height:1.3}
.foto-opt.on{background:#f57c00;color:#fff;border-color:#f57c00}
.drive-row{display:flex;gap:3px;margin-bottom:4px}
.drive-row input{flex:1;font-size:10px;padding:4px 7px;border-radius:6px;border:1.5px solid #e0e0e0;background:#fff}
.drive-row button{padding:4px 8px;border-radius:6px;border:none;background:#0f9d58;color:#fff;font-size:9px;font-weight:700;cursor:pointer;white-space:nowrap}
.foto-preview-wrap{display:flex;gap:8px;justify-content:center;margin-top:6px}
.foto-thumb{width:52px;height:52px;border-radius:50%;object-fit:cover;border:2.5px solid #1a73e8;display:none}
.foto-thumb-sq{width:52px;height:52px;border-radius:8px;object-fit:cover;border:2.5px solid #0f9d58;display:none}
.foto-ph{width:52px;height:52px;border-radius:50%;background:#e8f0fe;border:2px dashed #1a73e8;display:flex;align-items:center;justify-content:center;font-size:9px;color:#1a73e8;text-align:center;cursor:pointer;flex-shrink:0}
.logo-ph{width:52px;height:52px;border-radius:8px;background:#e8f5e9;border:2px dashed #0f9d58;display:flex;align-items:center;justify-content:center;font-size:9px;color:#0f9d58;text-align:center;cursor:pointer;flex-shrink:0}

/* ── QR ── */
.qr-pills{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px}
.qr-pill{font-size:9.5px;padding:4px 2px;border-radius:7px;border:1.5px solid #e0e0e0;cursor:pointer;color:#666;background:#f8f8f8;text-align:center;transition:all .15s;line-height:1.3}
.qr-pill.on{background:#1a73e8;color:#fff;border-color:#1a73e8}
.qr-style-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;margin-bottom:5px}
.qr-style-item{border-radius:7px;padding:4px 2px;text-align:center;cursor:pointer;border:1.5px solid #e8e8e8;background:#fafafa;transition:all .15s}
.qr-style-item.on{border-color:#1a73e8;background:#e8f0fe}
.qr-style-lbl{font-size:7px;color:#555;margin-top:1px}
.qr-colors{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px;margin-top:5px}
.qr-colors label{font-size:9.5px;color:#888;display:block;margin-bottom:2px}
.qr-colors input[type=color]{width:100%;height:26px;border-radius:5px;border:1px solid #e0e0e0;padding:1px;cursor:pointer}

/* ── PALETA ── */
.palette-cats{display:flex;gap:3px;flex-wrap:wrap;margin-bottom:5px}
.pcat{font-size:9px;padding:2px 7px;border-radius:20px;border:1px solid #e0e0e0;cursor:pointer;color:#888;background:#f8f8f8;transition:all .15s}
.pcat.on{background:#1a73e8;color:#fff;border-color:#1a73e8}
.palette-row{display:flex;gap:3px;flex-wrap:wrap;margin-bottom:5px}
.pal-sw{width:24px;height:24px;border-radius:50%;cursor:pointer;border:3px solid transparent;transition:all .15s;flex-shrink:0}
.pal-sw.on{border-color:#1a73e8;transform:scale(1.18)}
.color-picks{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:4px}
.color-picks label{font-size:9.5px;color:#888;display:block;margin-bottom:2px}
.color-picks input[type=color]{width:100%;height:26px;border-radius:5px;border:1px solid #e0e0e0;padding:1px;cursor:pointer}

/* ── TOGGLE ── */
.toggle-row{display:flex;justify-content:space-between;align-items:center;padding:3px 0;border-bottom:.5px solid #f0f0f0}
.toggle-lbl{font-size:10.5px;color:#333;font-weight:500}
.toggle{width:30px;height:17px;border-radius:20px;background:#e0e0e0;position:relative;cursor:pointer;transition:background .2s;flex-shrink:0}
.toggle.on{background:#1a73e8}
.toggle::after{content:'';width:13px;height:13px;border-radius:50%;background:#fff;position:absolute;top:2px;left:2px;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.toggle.on::after{left:15px}

/* ── BTNS ── */
.btn{padding:8px 14px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;border:none;transition:all .15s;width:100%}
.btn-blue{background:#1a73e8;color:#fff}.btn-blue:hover{background:#1557b0}
.btn-green{background:#0f9d58;color:#fff;margin-top:5px}.btn-green:hover{background:#0a7a42}
.btn-red{background:#ea4335;color:#fff}.btn-red:hover{background:#c5221f}
.btn-gray{background:#f0f2f5;color:#444;border:1px solid #e0e0e0}.btn-gray:hover{background:#e4e6ea}
.btn-row{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:5px}
.btn-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;margin-top:5px}

/* ── STAGE ── */
.stage-lbl{font-size:9.5px;font-weight:700;color:#bbb;letter-spacing:1px;text-transform:uppercase}
.view{display:none}.view.show{display:flex;flex-direction:column;gap:12px;align-items:center}
.dl-card{background:#fff;border-radius:12px;padding:12px;border:1px solid #e8e8e8;width:100%;max-width:340px}
.dl-title{font-size:10px;font-weight:700;color:#333;margin-bottom:8px;text-transform:uppercase;letter-spacing:.5px}
.dl-status{font-size:10px;color:#555;text-align:center;margin-top:6px;min-height:14px}

/* ── TARJETA ── */
.tarjeta{width:224px;min-height:394px;border-radius:20px;overflow:hidden;position:relative;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(0,0,0,.22)}
.card-body{flex:1;display:flex;flex-direction:column;padding:12px 11px 9px;gap:4px}
.card-avatar{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2.5px solid rgba(255,255,255,.45);flex-shrink:0;overflow:hidden}
.card-logo{width:44px;height:44px;border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;flex-shrink:0}
.card-logo img{width:100%;height:100%;object-fit:contain;border-radius:6px}

/* ── WEB PREVIEW ── */
.web-preview{width:300px;border-radius:14px;overflow:hidden;box-shadow:0 10px 36px rgba(0,0,0,.18);background:#f9f9f9}
.web-hero{padding:20px 14px 15px;text-align:center}
.web-avatar{width:66px;height:66px;border-radius:50%;margin:0 auto 9px;display:flex;align-items:center;justify-content:center;font-size:24px;border:3px solid rgba(255,255,255,.5);overflow:hidden}
.web-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.web-accent{height:4px;width:100%}
.web-body{padding:10px}
.web-sec{border-radius:9px;padding:9px;margin-bottom:7px}
.web-sec-t{font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;opacity:.65}
.web-crow{display:flex;align-items:center;gap:6px;margin-bottom:4px}
.web-icon{width:24px;height:24px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.web-gallery{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;margin-top:3px}
.web-gal{border-radius:6px;height:44px;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:600;overflow:hidden}
.web-gal img{width:100%;height:100%;object-fit:cover;border-radius:6px}
.web-svcs{display:grid;grid-template-columns:1fr 1fr;gap:3px}
.web-svc{border-radius:5px;padding:4px 6px;font-size:9.5px;font-weight:700;text-align:center;color:#fff}
.web-qr-row{display:flex;align-items:center;gap:9px;padding:7px;border-radius:9px;margin-bottom:7px}
.web-footer{padding:7px 12px;text-align:center;font-size:8px;letter-spacing:.5px;opacity:.55}

/* LOADING */
.loading-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,.6);z-index:5000;display:none;align-items:center;justify-content:center;flex-direction:column;gap:12px}
.loading-overlay.show{display:flex}
.loading-spinner{width:40px;height:40px;border:4px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{color:#fff;font-size:13px;font-weight:600}

@media(max-width:700px){.shell{grid-template-columns:1fr}.panel{border-right:none;border-bottom:1px solid #e0e0e0}.web-preview{width:280px}}
</style>
</head>
<body>

<!-- LOADING -->
<div class="loading-overlay" id="loadingOverlay">
  <div class="loading-spinner"></div>
  <div class="loading-text" id="loadingText">Generando imagen...</div>
</div>

<!-- LOGIN -->
<div id="loginScreen">
  <div class="login-box">
    <div class="login-logo">🪪</div>
    <div class="login-title">Mi Tarjeta Pro</div>
    <div class="login-sub">Panel privado · Acceso restringido</div>
    <label class="login-label">Usuario</label>
    <input class="login-input" id="loginUser" type="text" placeholder="usuario" onkeydown="if(event.key==='Enter')document.getElementById('loginPass').focus()">
    <label class="login-label">Contraseña</label>
    <div class="pass-wrap">
      <input class="login-input" id="loginPass" type="password" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin()">
      <button class="eye-btn" onclick="togglePass()">👁️</button>
    </div>
    <div class="login-err" id="loginErr"></div>
    <button class="login-btn" onclick="doLogin()">Ingresar →</button>
    <div class="login-attempts" id="loginAttempts"></div>
    <div class="login-footer">Mi Tarjeta Pro · v4.0 · Uso privado</div>
  </div>
</div>

<!-- APP -->
<div id="appContent" style="display:none">

<div class="hdr">
  <div class="hdr-title">Mi Tarjeta Pro <span>v4</span></div>
  <div class="mode-tabs">
    <div class="mode-tab on" onclick="setMode('card',this)">🪪 Tarjeta</div>
    <div class="mode-tab" onclick="setMode('web',this)">🌐 Web</div>
    <div class="mode-tab" onclick="setMode('both',this)">⚡ Ambas</div>
  </div>
</div>

<div class="shell">
<div class="panel">

  <!-- SHEETS -->
  <div class="sec">
    <div class="sec-title">📊 Pedidos de Google Sheets</div>
    <div class="sheet-bar">
      <div class="sheet-bar-title">🔗 Conectar tu Google Sheets</div>
      <div class="sheet-input-row">
        <input type="text" id="sheetId" placeholder="ID del Sheets (de la URL)">
        <button onclick="cargarSheet()">Cargar</button>
      </div>
      <div class="sheet-input-row" style="margin-bottom:5px">
        <input type="password" id="claveApp" placeholder="Clave secreta del script" style="font-family:monospace" value="LAqueES26$">
      </div>
      <div id="pedidosList"><div class="sheet-status">Ingresa el ID y toca Cargar</div></div>
    </div>
  </div>

  <!-- PROFESIÓN -->
  <div class="sec">
    <div class="sec-title">1. Profesión</div>
    <div class="prof-tabs">
      <div class="prof-tab on" id="ptLista" onclick="setProfMode('lista',this)">📋 De lista</div>
      <div class="prof-tab" id="ptManual" onclick="setProfMode('manual',this)">✏️ Manual</div>
    </div>
    <div id="profListaBlock">
      <div class="prof-grid" id="profGrid"></div>
    </div>
    <div id="profManualBlock" style="display:none">
      <div class="field"><label>Nombre de profesión</label><input id="profManualN" placeholder="Ej: Sommelier, Coach..." oninput="renderAll()"></div>
      <div class="field"><label>Subtítulo</label><input id="profManualS" placeholder="Ej: Vinos & Gastronomía" oninput="renderAll()"></div>
    </div>
  </div>

  <!-- ÍCONO -->
  <div class="sec">
    <div class="sec-title">2. Ícono visual</div>
    <div class="icon-tabs">
      <div class="icon-tab on" id="iconTabEmoji" onclick="setIconMode('emoji',this)">😊 Emoji<br>librería</div>
      <div class="icon-tab" id="iconTabCustom" onclick="setIconMode('custom',this)">🔤 Emoji<br>manual</div>
      <div class="icon-tab" id="iconTabNone" onclick="setIconMode('none',this)">❌ Sin<br>ícono</div>
    </div>
    <div id="iconEmojiBlock"><div class="icon-grid" id="iconGrid"></div></div>
    <div id="iconCustomBlock" style="display:none">
      <div class="field"><label>Escribe cualquier emoji</label>
        <input id="customEmoji" placeholder="🌿 🎸 🍕 💎..." oninput="renderAll()" style="font-size:18px;text-align:center">
      </div>
    </div>
  </div>

  <!-- FOTOS -->
  <div class="sec">
    <div class="sec-title">3. Foto y Logo del cliente</div>
    <!-- FOTO -->
    <div class="foto-block">
      <div class="foto-block-title">📷 Foto profesional</div>
      <div class="foto-opt-row">
        <div class="foto-opt on" id="fotoOptDrive" onclick="setFotoMode('foto','drive',this)">📁 Drive</div>
