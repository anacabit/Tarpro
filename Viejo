<script>
/* ══ LOGIN ══ */
const USERS=[{user:"admin",pass:"LAqueES26$"},{user:"mitarjeta",pass:"LAqueES26$"}];
let loginTries=0,lockUntil=0;

function doLogin(){
  const now=Date.now();
  if(now<lockUntil){document.getElementById("loginErr").textContent=`Bloqueado. Espera ${Math.ceil((lockUntil-now)/1000)}s`;return;}
  const u=document.getElementById("loginUser").value.trim().toLowerCase();
  const p=document.getElementById("loginPass").value;
  if(USERS.find(x=>x.user===u&&x.pass===p)){
    loginTries=0;
    const ls=document.getElementById("loginScreen");
    ls.style.transition="opacity .4s";ls.style.opacity="0";
    setTimeout(()=>{ls.style.display="none";document.getElementById("appContent").style.display="block";renderAll();},400);
  } else {
    loginTries++;
    if(loginTries>=3){
      lockUntil=Date.now()+30000;
      const iv=setInterval(()=>{const s=Math.ceil((lockUntil-Date.now())/1000);if(s<=0){clearInterval(iv);document.getElementById("loginErr").textContent="Puedes intentar de nuevo.";loginTries=0;}else document.getElementById("loginErr").textContent=`Bloqueado ${s}s`;},1000);
    } else {
      document.getElementById("loginErr").textContent=`Incorrecto (intento ${loginTries}/3)`;
      document.getElementById("loginPass").value="";
      document.getElementById("loginPass").focus();
      document.getElementById("loginAttempts").textContent=`Intentos restantes: ${3-loginTries}`;
    }
  }
}
function togglePass(){const p=document.getElementById("loginPass");p.type=p.type==="password"?"text":"password";}

/* ══ GOOGLE SHEETS ══ */
const SCRIPT_URL="https://script.google.com/macros/s/AKfycbz7G61tlKuYEW20c0IiN5l-qLP5l8MAEF77AdjUL5cpTGO8zqgAIA-XnBDe_IcbWTdU3g/exec";
const CLAVE_APP="LAqueES26$";

async function cargarSheet(){
  const list=document.getElementById("pedidosList");
  list.innerHTML='<div class="sheet-status">⏳ Conectando con Google Sheets...</div>';
  try{
    const clave=document.getElementById("claveApp")?document.getElementById("claveApp").value.trim()||CLAVE_APP:CLAVE_APP;
    const url=SCRIPT_URL+"?clave="+encodeURIComponent(clave);
    const res=await fetch(url);
    const json=await res.json();
    if(json.error){
      list.innerHTML='<div class="sheet-status">⚠️ '+json.error+' — verifica tu clave secreta</div>';
      return;
    }
    if(!json.pedidos||json.pedidos.length===0){
      list.innerHTML='<div class="sheet-status">📭 No hay pedidos aún en el Sheets</div>';
      return;
    }
    list.innerHTML="";
    json.pedidos.forEach((p,i)=>{
      const d=document.createElement("div");
      d.className="pedido-item";
      const estado=p.estado||"PENDIENTE";
      const colEst=estado==="LISTO"?"#c8e6c9":estado==="EN PROCESO"?"#fff9c4":"#ffcdd2";
      d.innerHTML=`<div style="display:flex;justify-content:space-between;align-items:center">
        <div class="pedido-nombre">${p.nombre}</div>
        <span style="font-size:8px;font-weight:700;padding:2px 6px;border-radius:10px;background:${colEst};color:#333">${estado}</span>
      </div>
      <div class="pedido-prof">${p.profesion}</div>
      <div class="pedido-fecha">${p.fecha} · Fila ${p.fila}</div>`;
      d.onclick=()=>{
        document.querySelectorAll(".pedido-item").forEach(el=>el.classList.remove("sel"));
        d.classList.add("sel");
        cargarPedidoDirecto(p);
      };
      list.appendChild(d);
    });
    const tot=document.createElement("div");
    tot.style.cssText="font-size:9px;color:rgba(255,255,255,.5);text-align:center;padding:5px 0";
    tot.textContent=json.total+" pedidos cargados";
    list.appendChild(tot);
  }catch(e){
    list.innerHTML='<div class="sheet-status">⚠️ Error de conexión: '+e.message+'</div>';
  }
}

function cargarPedidoDirecto(p){
  document.getElementById("fNombre").value=p.nombre||"";
  document.getElementById("fEmpresa").value=p.empresa||"";
  document.getElementById("fEslogan").value=p.eslogan||"";
  document.getElementById("fWa").value=p.whatsapp||"";
  document.getElementById("fEmail").value=p.email||"";
  document.getElementById("fWeb").value=p.web||"";
  document.getElementById("fIg").value=p.instagram||"";
  document.getElementById("fDesc").value=p.descripcion||"";
  document.getElementById("fSvcs").value=p.servicios||"";
  document.getElementById("fQrDato").value=p.msgQR||"Hola! Vi tu tarjeta y quisiera información.";

  // Profesión
  if(p.profesion){
    const idx=PROFS.findIndex(pr=>p.profesion.includes(pr.n)||pr.n.includes(p.profesion.split(" ")[0]));
    if(idx>=0){
      S.profIdx=idx;S.iconEmoji=PROFS[idx].e;
      document.querySelectorAll(".prof-item").forEach((el,j)=>el.classList.toggle("on",j===idx));
      setProfMode("lista",document.getElementById("ptLista"));
    } else {
      setProfMode("manual",document.getElementById("ptManual"));
      document.getElementById("profManualN").value=p.profesion;
      document.getElementById("profManualS").value=p.profesion;
    }
  }

  // Foto y logo desde Drive
  if(p.linkFoto&&p.linkFoto.includes("drive")){
    document.getElementById("driveLinkFoto").value=p.linkFoto;
    cargarDrive("foto");
  }
  if(p.linkLogo&&p.linkLogo.includes("drive")){
    document.getElementById("driveLinkLogo").value=p.linkLogo;
    cargarDrive("logo");
  }

  // Color preferido
  const colorPref=(p.color||"").toLowerCase();
  if(colorPref.includes("azul")) S.paletteCat="Azules";
  else if(colorPref.includes("verde")) S.paletteCat="Verdes";
  else if(colorPref.includes("rosa")||colorPref.includes("rojo")) S.paletteCat="Rojos & Rosas";
  else if(colorPref.includes("morado")) S.paletteCat="Morados";
  else if(colorPref.includes("negro")||colorPref.includes("oscuro")) S.paletteCat="Oscuros";
  buildPaletteCats();buildPaletteSwatches();

  // QR tipo
  if(p.tipoQR){
    if(p.tipoQR.toLowerCase().includes("whats")){setQR("wa",document.querySelector(".qr-pill"));}
    else if(p.tipoQR.toLowerCase().includes("vcard")||p.tipoQR.toLowerCase().includes("guardar")){setQR("vcard",document.querySelectorAll(".qr-pill")[2]);}
    else{setQR("perfil",document.querySelectorAll(".qr-pill")[1]);}
  }

  renderAll();
  status("st1","✅ Datos de "+p.nombre+" cargados — Fila "+p.fila);
  status("st3","✅ Datos de "+p.nombre+" cargados");
}

function cargarPedido(c,cols){
  // Map columns A-AE (0-30)
  const v=(i)=>c[i]&&c[i].v?String(c[i].v):"";
  // Columnas según tu form: A=tiempo B=nombre C=profesion D=empresa E=eslogan
  // F=WA G=tel H=email I=web J=ciudad K=dir L=IG M=FB N=LI O=TK
  // P=color Q=estilo R=foto S=QR T=msgQR U=fotoLink V=logoLink W=galeriaLinks
  // X=quiereweb Y=desc Z=servicios AA=comentarios AB=estado AC=pago AD=link AE=notas
  document.getElementById("fNombre").value=v(1);
  document.getElementById("fEmpresa").value=v(3);
  document.getElementById("fEslogan").value=v(4);
  document.getElementById("fWa").value=v(5);
  document.getElementById("fEmail").value=v(7);
  document.getElementById("fWeb").value=v(8);
  document.getElementById("fIg").value=v(11);
  document.getElementById("fDesc").value=v(24)||"";
  document.getElementById("fSvcs").value=v(25)||"";
  document.getElementById("fQrDato").value=v(19)||"Hola! Vi tu tarjeta y quisiera información.";

  // Profesión
  const profVal=v(2);
  if(profVal){
    document.getElementById("fNombre").dispatchEvent(new Event("input"));
    // try to match emoji profession
    const idx=PROFS.findIndex(p=>profVal.includes(p.n)||p.n.includes(profVal.split(" ")[0]));
    if(idx>=0){
      S.profIdx=idx;S.iconEmoji=PROFS[idx].e;
      document.querySelectorAll(".prof-item").forEach((el,j)=>el.classList.toggle("on",j===idx));
    } else {
      // switch to manual
      setProfMode("manual",document.getElementById("ptManual"));
      document.getElementById("profManualN").value=profVal;
      document.getElementById("profManualS").value=v(2);
    }
  }

  // Foto desde Drive
  const fotoLink=v(20);
  if(fotoLink){
    document.getElementById("driveLinkFoto").value=fotoLink;
    cargarDrive("foto");
  }
  const logoLink=v(21);
  if(logoLink){
    document.getElementById("driveLinkLogo").value=logoLink;
    cargarDrive("logo");
  }

  // Color preferido — auto match palette
  const colorPref=v(15).toLowerCase();
  if(colorPref.includes("azul")){S.paletteCat="Azules";}
  else if(colorPref.includes("verde")){S.paletteCat="Verdes";}
  else if(colorPref.includes("rosa")||colorPref.includes("rojo")){S.paletteCat="Rojos & Rosas";}
  else if(colorPref.includes("morado")){S.paletteCat="Morados";}
  else if(colorPref.includes("negro")||colorPref.includes("oscuro")){S.paletteCat="Oscuros";}
  buildPaletteCats();buildPaletteSwatches();

  renderAll();
  status("st1","✅ Datos del cliente cargados");
  status("st3","✅ Datos del cliente cargados");
}

