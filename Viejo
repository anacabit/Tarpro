  const html=`<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${nombre}</title>
<style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:Arial,sans-serif;background:#f5f5f5;min-height:100vh;display:flex;justify-content:center;padding:20px 10px}.card{max-width:420px;width:100%;border-radius:18px;overflow:hidden;box-shadow:0 8px 30px rgba(0,0,0,.15);background:#fff}.hero{background:${c1};padding:28px 20px 22px;text-align:center}.ava{width:80px;height:80px;border-radius:50%;margin:0 auto 12px;border:3px solid rgba(255,255,255,.5);display:flex;align-items:center;justify-content:center;overflow:hidden;background:${a2(c2,.3)}}.name{font-size:22px;font-weight:700;color:${tc};margin-bottom:4px}.prof{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:${tc};opacity:.8;margin-bottom:6px}.tag{font-size:13px;font-style:italic;color:${tc};opacity:.75}.accent{height:5px;background:${c2}}.body{padding:16px}.sec{background:${a2(c2,.15)};border-radius:10px;padding:14px;margin-bottom:12px}.st{font-size:10px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:${c1};margin-bottom:10px;opacity:.75}.svcs{display:grid;grid-template-columns:1fr 1fr;gap:6px}.svc{background:${c1};color:#fff;border-radius:7px;padding:7px 10px;font-size:12px;font-weight:600;text-align:center}.gal{display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px}.gi{background:${a2(c1,.12)};border-radius:8px;height:60px;display:flex;align-items:center;justify-content:center;font-size:11px;color:${c1};font-weight:600}.crow{display:flex;align-items:center;gap:10px;margin-bottom:8px;text-decoration:none;color:#333}.ci{width:32px;height:32px;border-radius:50%;background:${c1};display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#fff;font-size:15px}.foot{background:${c1};color:rgba(255,255,255,.65);text-align:center;padding:10px;font-size:10px}a{text-decoration:none}</style></head>
<body><div class="card">
<div class="hero"><div class="ava">${fotoTag}</div>${logoTag}<div class="name">${nombre}</div><div class="prof">${profNombre}</div><div class="tag">${eslogan}</div></div>
<div class="accent"></div><div class="body">
${desc?`<div class="sec"><div class="st">Sobre mí</div><p style="font-size:13px;color:#333;line-height:1.7">${desc}</p></div>`:""}
${svcs.length?`<div class="sec"><div class="st">Servicios</div><div class="svcs">${svcs.map(s=>`<div class="svc">${s}</div>`).join("")}</div></div>`:""}
<div class="sec"><div class="st">Galería</div><div class="gal">${[1,2,3,4,5,6].map(i=>`<div class="gi">Foto ${i}</div>`).join("")}</div></div>
<div class="sec"><div class="st">Contacto</div>
<a class="crow" href="tel:${waVal}"><div class="ci">📞</div>${waVal}</a>
<a class="crow" href="mailto:${emailVal}"><div class="ci">✉️</div>${emailVal}</a>
