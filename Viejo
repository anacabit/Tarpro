const SZ=21;

function isEye(r,c){return(r<7&&c<7)||(r<7&&c>=SZ-7)||(r>=SZ-7&&c<7);}

function drawQRStyled(canvas,style,fg,bg,eyeColor){
  const ctx=canvas.getContext("2d");
  const W=canvas.width,H=canvas.height;
  const pad=4;
  const cell=(W-pad*2)/SZ;
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle=bg||"#fff";
  ctx.beginPath();ctx.roundRect(0,0,W,H,6);ctx.fill();
  for(let r=0;r<SZ;r++){
    for(let c=0;c<SZ;c++){
      if(!QR_DATA[r][c]) continue;
      const x=pad+c*cell,y=pad+r*cell;
      const cx=x+cell/2,cy=y+cell/2;
      const s=cell*0.88;
      const eye=isEye(r,c);
      ctx.fillStyle=eye?(eyeColor||fg):fg;
      if(style==="classic"||eye){ctx.fillRect(x+.5,y+.5,cell-1,cell-1);}
      else if(style==="round"){ctx.beginPath();ctx.roundRect(x+.5,y+.5,cell-1,cell-1,cell*.38);ctx.fill();}
      else if(style==="dots"){ctx.beginPath();ctx.arc(cx,cy,s*.46,0,Math.PI*2);ctx.fill();}
      else if(style==="diamond"){const r2=s*.5;ctx.beginPath();ctx.moveTo(cx,cy-r2);ctx.lineTo(cx+r2,cy);ctx.lineTo(cx,cy+r2);ctx.lineTo(cx-r2,cy);ctx.closePath();ctx.fill();}
      else if(style==="cross"){const t=s*.25,arm=s*.5;ctx.fillRect(cx-t,cy-arm,t*2,arm*2);ctx.fillRect(cx-arm,cy-t,arm*2,t*2);}
      else if(style==="hlines"){ctx.fillRect(x+.5,y+cell*.2,cell-1,cell*.6);}
      else if(style==="vlines"){ctx.fillRect(x+cell*.2,y+.5,cell*.6,cell-1);}
      else if(style==="star"){const n=4,R=s*.5,ri=s*.2;ctx.beginPath();for(let i=0;i<n*2;i++){const ang=(i*Math.PI/n)-Math.PI/2;const rad=i%2===0?R:ri;i===0?ctx.moveTo(cx+rad*Math.cos(ang),cy+rad*Math.sin(ang)):ctx.lineTo(cx+rad*Math.cos(ang),cy+rad*Math.sin(ang));}ctx.closePath();ctx.fill();}
    }
  }
}

