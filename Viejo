function aleatorio(){
  S.profIdx=Math.floor(Math.random()*PROFS.length);
  const p=PROFS[S.profIdx];S.iconEmoji=p.e;
  S.bgStyle=Math.floor(Math.random()*BG_STYLES.length);
  S.heroStyle=Math.floor(Math.random()*HERO_STYLES.length);
  S.foto=Math.floor(Math.random()*FOTO_OPTS.length);
  S.qrPos=Math.floor(Math.random()*QR_POS.length);
  S.font=Math.floor(Math.random()*FONTS.length);
  S.wm=Math.floor(Math.random()*WM_OPTS.length);
  S.qrStyle=QR_STYLES_LIST[Math.floor(Math.random()*QR_STYLES_LIST.length)].v;
  S.txt=Math.random()>.4?"white":"dark";
  const cats=Object.keys(PALETTES);
  S.paletteCat=cats[Math.floor(Math.random()*cats.length)];
  const pal=PALETTES[S.paletteCat];
  S.c1=pal[Math.floor(Math.random()*pal.length)].c;
  S.c2=pal[Math.floor(Math.random()*pal.length)].c;
  document.getElementById("c1pick").value=S.c1;
  document.getElementById("c2pick").value=S.c2;
  document.getElementById("fNombre").value=p.n+" Pro";
  document.getElementById("fEslogan").value=p.s;
  document.querySelectorAll(".prof-item").forEach((el,j)=>el.classList.toggle("on",j===S.profIdx));
  buildPaletteCats();buildPaletteSwatches();syncIconGrid();
  ["bgStylePills","fotoPills","qrPosPills","fontPills","wmPills","heroStylePills"].forEach((id,ki)=>{
    const keys=["bgStyle","foto","qrPos","font","wm","heroStyle"];
    document.querySelectorAll("#"+id+" .pill").forEach((el,j)=>el.classList.toggle("on",j===S[keys[ki]]));
  });
  document.getElementById("txtW").classList.toggle("on",S.txt==="white");
  document.getElementById("txtD").classList.toggle("on",S.txt==="dark");
  document.querySelectorAll(".qr-style-item").forEach((el,j)=>el.classList.toggle("on",QR_STYLES_LIST[j]?.v===S.qrStyle));
  renderAll();
}

function copiarQRLink(){
