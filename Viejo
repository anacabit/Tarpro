    if(m!=="none") document.getElementById("fotoBlock"+m.charAt(0).toUpperCase()+m.slice(1)).style.display="block";
    if(m==="none"){S.fotoSrc=null;updatePreviews();}
  } else {
    S.logoMode=m;
    document.querySelectorAll("#logoOptDrive,#logoOptFile,#logoOptUrl,#logoOptNone").forEach(f=>f.classList.remove("on"));
    el.classList.add("on");
    ["logoBlockDrive","logoBlockFile","logoBlockUrl"].forEach(id=>document.getElementById(id).style.display="none");
