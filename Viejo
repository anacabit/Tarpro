  }
}

function cargarDrive(tipo){
  const input=tipo==="foto"?"driveLinkFoto":"driveLinkLogo";
  const url=document.getElementById(input).value.trim();
  let fileId="";
  const m1=url.match(/\/file\/d\/([^\/\?]+)/);
  const m2=url.match(/id=([^&]+)/);
  if(m1) fileId=m1[1];
  else if(m2) fileId=m2[1];
  if(fileId){
    const src=`https://drive.google.com/thumbnail?id=${fileId}&sz=w400`;
    if(tipo==="foto") S.fotoSrc=src;
    else S.logoSrc=src;
    updatePreviews();
    status("st1","✅ "+(tipo==="foto"?"Foto":"Logo")+" cargado desde Drive");
  } else {
    status("st1","⚠️ Link de Drive no válido");
  }
}

function cargarFile(tipo,input){
  const file=input.files[0];
  if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{
    if(tipo==="foto") S.fotoSrc=e.target.result;
    else S.logoSrc=e.target.result;
    updatePreviews();renderAll();
  };
  reader.readAsDataURL(file);
}

function cargarURL(tipo){
  const url=tipo==="foto"?document.getElementById("urlFoto").value.trim():document.getElementById("urlLogo").value.trim();
  if(!url) return;
  if(tipo==="foto") S.fotoSrc=url;
  else S.logoSrc=url;
  updatePreviews();renderAll();
}

function updatePreviews(){
  // Foto
  const fp=document.getElementById("fotoPreview");
  const fph=document.getElementById("fotoPH");
  if(S.fotoSrc&&S.fotoMode!=="none"){
    fp.src=S.fotoSrc;fp.style.display="block";fph.style.display="none";
    fp.onload=()=>renderAll();
    fp.onerror=()=>{S.fotoSrc=null;fp.style.display="none";fph.style.display="flex";};
  } else {fp.style.display="none";fph.style.display="flex";}
  // Logo
  const lp=document.getElementById("logoPreview");
  const lph=document.getElementById("logoPH");
  if(S.logoSrc&&S.logoMode!=="none"){
    lp.src=S.logoSrc;lp.style.display="block";lph.style.display="none";
    lp.onload=()=>renderAll();
    lp.onerror=()=>{S.logoSrc=null;lp.style.display="none";lph.style.display="flex";};
  } else {lp.style.display="none";lph.style.display="flex";}
}

/* ══ AVATAR HTML ══ */
function avatarHTML(size,fs,tc,c2){
  const emoji=getActiveEmoji();
  const st=`width:${size}px;height:${size}px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:${fs}px;border:2.5px solid rgba(255,255,255,.45);flex-shrink:0;overflow:hidden;background:${alpha(c2,.22)}`;
  if(S.fotoSrc&&S.fotoMode!=="none"){
    return`<div style="${st}"><img src="${S.fotoSrc}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block" crossorigin="anonymous"></div>`;
  }
  if(!emoji) return"";
  return`<div style="${st};color:${tc}">${emoji}</div>`;
}

function logoHTML(size){
  if(!S.logoSrc||S.logoMode==="none") return"";
  return`<div style="width:${size}px;height:${size}px;border-radius:7px;overflow:hidden;flex-shrink:0;background:rgba(255,255,255,0.15);display:flex;align-items:center;justify-content:center"><img src="${S.logoSrc}" style="width:100%;height:100%;object-fit:contain;border-radius:6px" crossorigin="anonymous"></div>`;
}

/* ══ RENDER TARJETA ══ */
function renderCard(cardId,qrId){
  const nombre=document.getElementById("fNombre").value||"Tu Nombre";
  const empresa=document.getElementById("fEmpresa").value||"Tu Empresa";
  const eslogan=document.getElementById("fEslogan").value||"Tu eslogan";
  const waVal=document.getElementById("fWa").value;
  const emailVal=document.getElementById("fEmail").value;
  const webVal=document.getElementById("fWeb").value;
  const igVal=document.getElementById("fIg").value;
  const profNombre=getActiveProfName();
  const c1=S.c1,c2=S.c2;
  const font=FONTS[S.font].v;
  const foto=FOTO_OPTS[S.foto].v;
  const qrPos=QR_POS[S.qrPos].v;
  const tc=S.txt==="white"?"#ffffff":"#111111";
  const tc2=S.txt==="white"?"rgba(255,255,255,.72)":"rgba(0,0,0,.6)";
  const bg=getBG(BG_STYLES[S.bgStyle].v,c1,c2);

  const ava=avatarHTML(60,22,tc,c2);
  const logo=logoHTML(38);

  // empresa + logo row
  const empresaRow=logo
    ?`<div style="display:flex;align-items:center;justify-content:space-between;width:100%">${logo}<div style="font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:${tc2};font-family:${font};text-align:right;flex:1;padding-left:5px">${empresa}</div></div>`
    :`<div style="font-size:8px;letter-spacing:1.5px;text-transform:uppercase;color:${tc2};font-family:${font}">${empresa}</div>`;

  const info=`<div style="display:flex;flex-direction:column;gap:3px">
    <div style="display:flex;align-items:center;gap:5px;font-size:10px;color:${tc2}">${SVG.phone(tc2)}<span>${waVal}</span></div>
    <div style="display:flex;align-items:center;gap:5px;font-size:9.5px;color:${tc2};word-break:break-all">${SVG.mail(tc2)}<span>${emailVal}</span></div>
    <div style="display:flex;align-items:center;gap:5px;font-size:10px;color:${tc2}">${SVG.web(tc2)}<span>${webVal}</span></div>
  </div>
  <div style="display:flex;gap:7px;margin-top:3px;align-items:center;color:${tc2}">${SVG.ig(tc2)}<span style="font-size:10px">${igVal}</span>${SVG.wa(tc2)}</div>
  <div style="display:flex;align-items:center;gap:4px;font-size:8.5px;opacity:.6;margin-top:2px;color:${tc2}">${SVG.save(tc2)} Guardar contacto</div>`;

  const nb=`<div style="font-size:16px;font-weight:800;line-height:1.2;color:${tc};font-family:${font}">${nombre}</div>
    <div style="font-size:11px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;opacity:.82;color:${tc2};font-family:${font}">${profNombre}</div>
    <div style="font-size:9px;font-style:italic;opacity:.7;color:${tc2};font-family:${font}">${eslogan}</div>`;
  const div=`<div style="height:1px;background:rgba(255,255,255,.22);margin:3px 0"></div>`;

  let body="";
  if(foto==="none")        body=`${empresaRow}${nb}${div}${info}`;
  else if(foto==="center") body=`${empresaRow}<div style="display:flex;justify-content:center">${ava}</div>${nb}${div}${info}`;
  else if(foto==="left")   body=`${empresaRow}<div style="display:flex;align-items:flex-start;gap:8px">${ava}<div style="flex:1">${nb}</div></div>${div}${info}`;
  else if(foto==="right")  body=`${empresaRow}<div style="display:flex;align-items:flex-start;gap:8px"><div style="flex:1">${nb}</div>${ava}</div>${div}${info}`;
  else if(foto==="topleft")body=`<div style="display:flex;align-items:center;gap:7px">${ava}${empresaRow}</div>${div}${nb}${div}${info}`;
  else                     body=`<div style="display:flex;align-items:center;justify-content:flex-end;gap:7px">${empresaRow}${ava}</div>${div}${nb}${div}${info}`;

  // watermark
  const wc=S.txt==="white"?"rgba(255,255,255,.07)":"rgba(0,0,0,.06)";
  let wm="";
  if(S.wm===1) wm=`<div style="position:absolute;top:50%;left:-10%;transform:rotate(-35deg);font-size:22px;font-weight:900;letter-spacing:3px;text-transform:uppercase;color:${wc};font-family:${font};pointer-events:none;white-space:nowrap">${empresa} ${empresa}</div>`;
  if(S.wm===2) wm=`<div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:38px;color:${wc};pointer-events:none">${getActiveEmoji()||"★"}</div>`;
  if(S.wm===3) wm=`<div style="position:absolute;bottom:22px;right:8px;font-size:7px;opacity:.3;color:${tc};font-family:${font};pointer-events:none">${empresa}</div>`;
  if(S.wm===4) wm=`<div style="position:absolute;bottom:14px;left:0;right:0;text-align:center;font-size:7px;letter-spacing:2px;opacity:.3;color:${tc};font-family:${font};pointer-events:none">${empresa.toUpperCase()}</div>`;

  const qps={bl:"bottom:12px;left:10px",br:"bottom:12px;right:10px",bc:"bottom:12px;left:50%;transform:translateX(-50%)",tl:"top:18px;left:10px",side:"right:8px;top:50%;transform:translateY(-50%)"};
  const qrHTML=qrPos!=="none"?`<div id="${qrId}" style="position:absolute;${qps[qrPos]};z-index:10;background:#fff;border-radius:7px;padding:3px"></div>`:`<div id="${qrId}" style="display:none"></div>`;

  const card=document.getElementById(cardId);
  if(!card) return;
  card.style.background=bg;
  card.innerHTML=`
    <div style="height:5px;width:100%;background:${c2}"></div>
    ${wm}
    <div style="flex:1;display:flex;flex-direction:column;padding:12px 11px 9px;gap:4px">${body}</div>
    ${qrHTML}
    <div style="font-size:7.5px;text-align:center;padding:5px;letter-spacing:.8px;opacity:.45;color:${tc};font-family:${font}">MI TARJETA PRO · $5</div>`;
  setTimeout(()=>makeStyledQR(qrId,50),60);
}

/* ══ RENDER WEB ══ */
function renderWeb(containerId,qrId){
  const nombre=document.getElementById("fNombre").value||"Tu Nombre";
  const empresa=document.getElementById("fEmpresa").value||"Tu Empresa";
  const eslogan=document.getElementById("fEslogan").value||"Tu eslogan";
  const desc=document.getElementById("fDesc").value||"Profesional con experiencia.";
  const waVal=document.getElementById("fWa").value;
  const emailVal=document.getElementById("fEmail").value;
  const webVal=document.getElementById("fWeb").value;
  const igVal=document.getElementById("fIg").value;
  const svcs=document.getElementById("fSvcs").value.split(",").map(s=>s.trim()).filter(Boolean).slice(0,4);
  const profNombre=getActiveProfName();
  const c1=S.c1,c2=S.c2;
  const tc=S.txt==="white"?"#ffffff":"#111111";
  const sec2=alpha(c2,.18);
  const emoji=getActiveEmoji();

  const webAva=S.fotoSrc&&S.fotoMode!=="none"
    ?`<div class="web-avatar" style="background:${alpha(c2,.28)};border:3px solid rgba(255,255,255,.5)"><img src="${S.fotoSrc}" style="width:100%;height:100%;object-fit:cover;border-radius:50%" crossorigin="anonymous"></div>`
    :`<div class="web-avatar" style="background:${alpha(c2,.28)};color:${tc}">${emoji}</div>`;

  const webLogo=S.logoSrc&&S.logoMode!=="none"
    ?`<div style="width:44px;height:44px;border-radius:8px;overflow:hidden;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;margin:0 auto 6px"><img src="${S.logoSrc}" style="width:100%;height:100%;object-fit:contain" crossorigin="anonymous"></div>`
    :"";

  let html=`<div class="web-hero" style="background:${getHeroBG(HERO_STYLES[S.heroStyle].v,c1,c2)}">
    ${webAva}${webLogo}
    <div style="font-size:16px;font-weight:700;line-height:1.2;margin-bottom:3px;color:${tc}">${nombre}</div>
    <div style="font-size:9.5px;letter-spacing:1.5px;text-transform:uppercase;opacity:.8;margin-bottom:4px;color:${tc}">${profNombre}</div>
    <div style="font-size:10.5px;font-style:italic;opacity:.7;color:${tc}">${eslogan}</div>
  </div>
  <div class="web-accent" style="background:${c2}"></div>
  <div class="web-body" style="background:#f9f9f9">`;

  const ws=S.webSecs;
  if(ws.sobremi)   html+=`<div class="web-sec" style="background:${sec2}"><div class="web-sec-t" style="color:${c1}">Sobre mí</div><div style="font-size:10.5px;color:#333;line-height:1.6">${desc}</div></div>`;
  if(ws.servicios) html+=`<div class="web-sec" style="background:${sec2}"><div class="web-sec-t" style="color:${c1}">Servicios</div><div class="web-svcs">${svcs.map(s=>`<div class="web-svc" style="background:${c1}">${s}</div>`).join("")}</div></div>`;
  if(ws.galeria)   html+=`<div class="web-sec" style="background:${sec2}"><div class="web-sec-t" style="color:${c1}">Galería</div><div class="web-gallery">${[1,2,3,4,5,6].map(i=>`<div class="web-gal" style="background:${alpha(c1,.1+i*.04)};color:${c1}">Foto ${i}</div>`).join("")}</div></div>`;
  if(ws.contacto)  html+=`<div class="web-sec" style="background:${sec2}"><div class="web-sec-t" style="color:${c1}">Contacto</div>
    <div class="web-crow"><div class="web-icon" style="background:${c1}">${SVG.phone("#fff")}</div><span style="font-size:10.5px;color:#333">${waVal}</span></div>
    <div class="web-crow"><div class="web-icon" style="background:${c1}">${SVG.mail("#fff")}</div><span style="font-size:10px;color:#333;word-break:break-all">${emailVal}</span></div>
    <div class="web-crow"><div class="web-icon" style="background:#e1306c">${SVG.ig("#fff")}</div><span style="font-size:10.5px;color:#333">${igVal}</span></div>
    <div class="web-crow"><div class="web-icon" style="background:#25d366">${SVG.wa("#fff")}</div><span style="font-size:10.5px;color:#333">WhatsApp directo</span></div>
    <div class="web-crow"><div class="web-icon" style="background:${c1}">${SVG.web("#fff")}</div><span style="font-size:10.5px;color:#333">${webVal}</span></div>
  </div>`;
  if(ws.qr)        html+=`<div class="web-qr-row" style="background:${sec2}"><div id="${qrId}"></div><div><div style="font-size:11px;font-weight:700;color:${c1};margin-bottom:3px">Escanea y contáctame</div><div style="font-size:9.5px;color:#666">WhatsApp · Contacto · Perfil</div></div></div>`;
  if(ws.ubicacion) html+=`<div class="web-sec" style="background:${sec2}"><div class="web-sec-t" style="color:${c1}">Ubicación</div><div style="background:${alpha(c1,.1)};border-radius:7px;height:46px;display:flex;align-items:center;justify-content:center;font-size:10.5px;color:${c1};font-weight:600">📍 Mapa de Google</div></div>`;
  html+=`</div><div class="web-footer" style="background:${c1};color:rgba(255,255,255,.65)">${empresa} · Mi Tarjeta Pro</div>`;

  const box=document.getElementById(containerId);
  if(box){
    box.innerHTML=html;
    setTimeout(()=>{
      const qrBox=document.getElementById(qrId);
      if(qrBox){
        qrBox.style.cssText="background:#fff;border-radius:7px;padding:3px;display:inline-block";
        const cv=document.createElement("canvas");cv.width=44;cv.height=44;
        qrBox.appendChild(cv);
        const fg=document.getElementById("qrFg").value;
        const bg2=document.getElementById("qrBg").value;
        const eye=document.getElementById("qrEye").value;
        drawQRStyled(cv,S.qrStyle,fg,bg2,eye);
      }
    },80);
  }
}

function setBgImg(m,el){
  S.bgImgMode=m;
  document.querySelectorAll("#bgImgOptNone,#bgImgOptFile,#bgImgOptDrive,#bgImgOptUrl").forEach(f=>f.classList.remove("on"));
  el.classList.add("on");
  ["bgImgBlockFile","bgImgBlockDrive","bgImgBlockUrl"].forEach(id=>document.getElementById(id).style.display="none");
  if(m==="file") document.getElementById("bgImgBlockFile").style.display="block";
  if(m==="drive") document.getElementById("bgImgBlockDrive").style.display="block";
  if(m==="url") document.getElementById("bgImgBlockUrl").style.display="block";
  if(m==="none"){S.bgImgSrc=null;document.getElementById("bgImgPreviewWrap").style.display="none";renderAll();}
}

function cargarBgFile(input){
  const file=input.files[0];if(!file)return;
  const reader=new FileReader();
  reader.onload=e=>{S.bgImgSrc=e.target.result;showBgPreview();renderAll();};
  reader.readAsDataURL(file);
}

function cargarBgDrive(){
  const url=document.getElementById("driveLinkBg").value.trim();
  let fileId="";
  const m1=url.match(/\/file\/d\/([^\/\?]+)/);
  const m2=url.match(/id=([^&]+)/);
  if(m1) fileId=m1[1];else if(m2) fileId=m2[1];
  if(fileId){S.bgImgSrc=`https://drive.google.com/thumbnail?id=${fileId}&sz=w800`;showBgPreview();renderAll();}
}

function cargarBgUrl(){
  const url=document.getElementById("urlBg").value.trim();
  if(!url)return;
  S.bgImgSrc=url;showBgPreview();renderAll();
}

function showBgPreview(){
  const prev=document.getElementById("bgImgPreview");
  const wrap=document.getElementById("bgImgPreviewWrap");
  if(S.bgImgSrc){prev.src=S.bgImgSrc;wrap.style.display="block";}
}

function renderAll(){
  const m=S.mode;
  if(m==="card") renderCard("card","qrC");
  if(m==="web")  renderWeb("webPreview","qrW");
  if(m==="both"){renderCard("card2","qrC2");renderWeb("webPreview2","qrW2");}
}

